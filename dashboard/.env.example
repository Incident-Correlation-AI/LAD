# Dashboard dev-server settings. Copy to `.env.local` (gitignored) if you need
# to override; the dashboard falls back to the repo-root `.env`.

# Where the Vite dev server proxies /api requests.
LAD_API_TARGET=http://127.0.0.1:8080

# Admin credential for the incidents API. Read by the dev server ONLY and
# injected into proxied requests — it is never part of the browser bundle.
# Set this once in the repo-root .env instead of duplicating it here.
# LAD_ADMIN_TOKEN=...
